generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id                    String                       @id @default(cuid())
  email                 String                       @unique
  firstName             String
  lastName              String
  phone                 String?
  socialLink            String?
  password              String?
  googleId              String?                      @unique
  authProvider          String?                      @default("credentials")
  emailVerified         DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  verificationToken     String?
  resetToken            String?
  resetTokenExpiry      DateTime?
  profilePicture        String?
  customProfilePicture  String?
  // headerStyle — kontroluje co pokazuje się w nagłówku landing page'a:
  //   'profile' → podpis + avatar (Google lub custom — patrz activeProfileSource)
  //   'logo'    → brand logo (z authorLogoUrl) zamiast podpisu
  //   'none'    → tylko podpis bez avatara (sam tekst)
  // Mutual exclusion wymuszone przez typ — nie da się aktywować obu naraz.
  headerStyle           String                       @default("none")
  // activeProfileSource — gdy headerStyle='profile' i user ma OBA źródła
  // (Google + custom), to pole decyduje które pokazać:
  //   'custom' → custom (priorytet domyślny po upload)
  //   'google' → Google (świadomie wybrane przez usera, custom zostaje w bazie)
  // Brak custom → fallback na Google (bez względu na to pole).
  activeProfileSource   String                       @default("custom")
  instagramProfileId    String?
  linkedinProfileId     String?
  socialProfileType     SocialProfileType            @default(NONE)
  instagramUsername     String?
  authorDisplayName     String?
  authorLogoUrl         String?
  // authorLogoOriginalUrl — original raw plik wgrany przez usera (zachowany do re-edycji).
  // authorLogoUrl to finalny cropped PNG, ten plik to oryginal sprzed cropu.
  // Pozwala na bezstratną re-edycję (zmiana proporcji/zoom) bez ponownego uploadu z dysku.
  authorLogoOriginalUrl String?
  imageAiModel          String?                      @default("imagen-3")
  imageAiProvider       String?                      @default("google")
  textAiModel           String?                      @default("claude-3-haiku")
  textAiProvider        String?                      @default("anthropic")
  role                  Role                         @default(free)
  stripeCustomerId      String?                      @unique
  stripeSubscriptionId  String?                      @unique
  subscriptionStatus    String?
  primaryDomainId       String?                      @unique
  paymentVerifiedAt     DateTime?
  nextBillingDate       DateTime?
  billingName           String?
  billingAddress        Json?
  cardLast4             String?
  cardBrand             String?
  companyName           String?
  taxId                 String?
  taxIdType             String?
  billingPreference     String?
  user_exp_profile      String?
  client_needs_profile  String?
  ebookSources          EbookSource[]
  ebooks                ebooks[]
  instagramAIAnalyses   InstagramCreatorAIAnalysis[]
  instagramAnalyses     InstagramCreatorAnalysis[]
  leads                 leads[]
  linkedinAIAnalyses    LinkedInCreatorAIAnalysis[]
  linkedinAnalyses      LinkedInCreatorAnalysis[]
  page_contents         page_content[]
  pages                 pages[]
  reels                 reels[]
  apiKeys               UserApiKey[]
  customDomains         CustomDomain[]
  inviteCode            InviteCode?
  instagramProfile      InstagramProfileCheck?       @relation(fields: [instagramProfileId], references: [id])
  linkedinProfile       LinkedInProfileCheck?        @relation(fields: [linkedinProfileId], references: [id])
  primaryDomain         CustomDomain?                @relation("UserPrimaryDomain", fields: [primaryDomainId], references: [id], onDelete: SetNull)

  @@map("users")
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String
  keyHash      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@map("user_api_keys")
}

model InstagramProfileCheck {
  id                 String   @id @default(cuid())
  instagramUrl       String
  instagramId        String?
  username           String
  fullName           String?
  biography          String?
  followersCount     Int?
  followsCount       Int?
  postsCount         Int?
  profilePicUrl      String?
  profilePicUrlHD    String?
  isBusinessAccount  Boolean  @default(false)
  isPrivate          Boolean  @default(false)
  isVerified         Boolean  @default(false)
  businessCategory   String?
  checkedAt          DateTime @default(now())
  userIp             String?
  userAgent          String?
  highlightReelCount Int?
  users              User[]

  @@map("instagram_profile_checks")
}

model LinkedInProfileCheck {
  id               String   @id @default(cuid())
  linkedinUrl      String
  firstName        String?
  lastName         String?
  fullName         String?
  headline         String?
  aboutExcerpt     String?
  connectionsCount Int?
  followersCount   Int?
  profilePicUrl    String?
  jobTitle         String?
  companyName      String?
  companyIndustry  String?
  location         String?
  topSkills        String?
  checkedAt        DateTime @default(now())
  userIp           String?
  userAgent        String?
  users            User[]

  @@map("linkedin_profile_checks")
}

model InstagramCreatorAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  username           String
  postId             String
  caption            String
  likesCount         Int      @default(0)
  commentsCount      Int      @default(0)
  videoPlayCount     Int?
  videoDuration      Int?
  commenterUsernames Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([username])
  @@index([postId])
  @@map("instagram_creator_analysis")
}

model LinkedInCreatorAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  username           String
  postUrn            String
  postDate           String
  postText           String
  totalReactions     Int      @default(0)
  commentsCount      Int      @default(0)
  commenterHeadlines String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postUrn])
  @@index([userId])
  @@index([username])
  @@index([postUrn])
  @@map("linkedin_creator_analysis")
}

model InstagramCreatorAIAnalysis {
  id                 String   @id @default(cuid())
  userId             String
  username           String
  profileDescription String
  competencies       Json
  uniqueTalent       Json
  metadata           Json
  postsAnalyzed      Int
  aiModel            String   @default("claude-3-5-sonnet-20241022")
  version            String   @default("2.0")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, username])
  @@index([userId])
  @@index([username])
  @@index([userId, username])
  @@map("instagram_creator_ai_analysis")
}

model LinkedInCreatorAIAnalysis {
  id                   String   @id @default(cuid())
  userId               String
  username             String
  profileDescription   String
  businessCompetencies Json
  expertiseNiche       Json
  metadata             Json
  postsAnalyzed        Int
  aiModel              String   @default("claude-3-5-sonnet-20241022")
  version              String   @default("2.0-linkedin")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, username])
  @@index([userId])
  @@index([username])
  @@index([userId, username])
  @@map("linkedin_creator_ai_analysis")
}

model ebook_chapters {
  id           Int       @id @default(autoincrement())
  ebook_id     Int
  title        String    @db.VarChar(255)
  content      String?
  position     Int
  image_url    String?   @db.VarChar(1024)
  image_prompt String?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  ebooks       ebooks    @relation(fields: [ebook_id], references: [id], onDelete: Cascade)

  @@index([ebook_id], map: "idx_ebook_chapters_ebook_id")
  @@index([ebook_id, position], map: "idx_ebook_chapters_position")
}

model ebooks {
  id                              Int              @id @default(autoincrement())
  title                           String           @db.VarChar(255)
  draft_url                       String?          @unique @db.VarChar(255)
  status                          String?          @default("draft") @db.VarChar(50)
  visitors                        Int?             @default(0)
  created_at                      DateTime?        @default(now()) @db.Timestamp(6)
  updated_at                      DateTime?        @default(now()) @db.Timestamp(6)
  x_amz_meta_user_id              Int?
  x_amz_meta_user_cognito_sub     String?          @db.VarChar(255)
  x_amz_meta_user_first_name      String?          @db.VarChar(100)
  x_amz_meta_user_last_name       String?          @db.VarChar(100)
  x_amz_meta_user_email           String?          @db.VarChar(255)
  x_amz_meta_user_role            String?          @db.VarChar(50)
  x_amz_meta_user_status          String?          @db.VarChar(50)
  x_amz_meta_user_supervisor_code String?          @db.VarChar(100)
  x_amz_meta_user_created_at      DateTime?        @db.Timestamp(6)
  x_amz_meta_user_updated_at      DateTime?        @db.Timestamp(6)
  category                        String?          @db.VarChar(100)
  short_desc                      String?
  subtitle                        String?
  description                     String?
  intro                           String?
  raw_intro                       String?
  cover_image_url                 String?
  cover_image_prompt              String?
  userId                          String?
  ai_generation_timestamp         DateTime?        @db.Timestamp(6)
  image_ai_model                  String?          @db.VarChar(100)
  image_ai_provider               String?          @db.VarChar(50)
  text_ai_model                   String?          @db.VarChar(100)
  text_ai_provider                String?          @db.VarChar(50)
  authorDisplayName               String?          @db.VarChar(200)
  authorLogoUrl                   String?          @db.VarChar(1024)
  cover_image_webp_url            String?
  final_mockup_url                String?
  total_pages                     Int?
  ebook_chapters                  ebook_chapters[]
  sources                         EbookSource[]
  user                            User?            @relation(fields: [userId], references: [id])
  page_contents                   page_content[]
  pages                           pages[]

  @@index([x_amz_meta_user_id], map: "idx_ebooks_user_id")
}

model EbookSource {
  id          Int        @id @default(autoincrement())
  ebook_id    Int
  user_id     String
  sourceType  SourceType
  url         String     @db.VarChar(1024)
  title       String     @db.VarChar(512)
  content     String
  sourceLabel String?    @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ebook       ebooks     @relation(fields: [ebook_id], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([ebook_id, url])
  @@index([ebook_id])
  @@index([user_id])
  @@map("ebook_sources")
}

model pages {
  id               String        @id @db.VarChar(255)
  title            String        @db.VarChar(255)
  headline         String?
  creator          String?       @db.VarChar(255)
  visits           Int?          @default(0)
  leadsCount       Int?          @default(0) @map("leads")
  type             String?       @db.VarChar(50)
  status           String        @db.VarChar(50)
  createdAt        DateTime?     @default(now()) @db.Timestamptz(6)
  url              String?       @db.VarChar(255)
  draft_url        String?       @db.VarChar(255)
  coverImage       String?       @db.VarChar(255)
  x_amz_meta_title String?       @db.VarChar(255)
  userId           String?       @db.VarChar(255)
  ebookId          Int?
  color            String?       @db.VarChar(50)
  language         String?       @default("en") @db.VarChar(5)
  customDomainId   String?       @db.VarChar(255)
  leads            leads[]
  content          page_content?
  ebook            ebooks?       @relation(fields: [ebookId], references: [id], onDelete: Cascade, map: "fk_ebook")
  user             User?         @relation(fields: [userId], references: [id], map: "fk_user")
  reels            reels?
  customDomain     CustomDomain? @relation("PageCustomDomain", fields: [customDomainId], references: [id], onDelete: SetNull)

  @@index([customDomainId])
}

model page_content {
  id             String   @id @default(cuid())
  pageId         String   @unique
  userId         String
  ebookId        Int?

  hero           Json?
  problem        Json?
  promise        Json?
  benefits       Json?
  content        Json?
  form           Json?
  faq            Json?

  schema_version String   @default("v2") @db.VarChar(10)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ebook          ebooks?  @relation(fields: [ebookId], references: [id])
  page           pages    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([userId])
  @@index([ebookId])
  @@map("page_contents")
}

model reels {
  id           String       @id @default(cuid())
  pageId       String       @unique
  userId       String
  ebookId      Int?
  reelIntro    String?
  reelCover    String?
  reelHeader   String?
  reelCTA      String?
  CTAtext      String?
  CTAoptions   Json?
  coverParams  Json?
  audioGender  AudioGender?
  audioURL     String?
  timestampURL String?
  reelURL      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  page         pages        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([userId])
  @@index([ebookId])
  @@map("reels")
}

model leads {
  id             Int       @id @default(autoincrement()) @map("lead_id")
  pageId         String?   @map("page_id")
  pageName       String?   @map("page_name")
  leadType       String?   @map("lead_type")
  userId         String?   @map("user_id")
  supervisorCode String?   @map("supervisor_code") @db.VarChar(255)
  leadDate       DateTime? @map("lead_date") @db.Date
  leadTime       DateTime? @map("lead_time") @db.Time(6)
  leadName       String    @map("lead_name")
  leadEmail      String    @map("lead_email")
  leadPhone      String?   @map("lead_phone")
  leadTimestamp  DateTime? @default(now()) @map("lead_timestamp") @db.Timestamptz(6)
  buyNow         Boolean?  @default(false) @map("buy_now")
  status         String?   @default("b_contact")
  comment        String?
  page           pages?    @relation(fields: [pageId], references: [id])
  user           User?     @relation(fields: [userId], references: [id])

  @@map("leads")
}

enum Role {
  admin
  demo
  free
  free_ver
  rookie
  creator
  unlimited
  payd
  premium
  GOD
}

model CustomDomain {
  id                   String       @id @default(cuid())
  userId               String
  domain               String       @unique
  status               DomainStatus @default(pending)
  cloudflareHostnameId String?      @unique
  sslStatus            String?      @db.VarChar(50)
  verificationErrors   Json?
  ownershipVerification Json?
  // dcvVerification — TXT rekord do walidacji certyfikatu SSL (DCV).
  // Cloudflare zwraca to pole tylko podczas wystawiania certa, po aktywacji
  // czyści `ssl.validation_records` w response. Trzymamy w naszej bazie żeby
  // móc pokazać user'owi kompletne instrukcje DNS niezależnie od stanu CF.
  dcvVerification      Json?
  lastCheckedAt        DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryFor           User?        @relation("UserPrimaryDomain")
  pages                pages[]      @relation("PageCustomDomain")

  @@index([userId])
  @@index([domain])
  @@index([status])
  @@map("custom_domains")
}

enum DomainStatus {
  pending
  verifying
  active
  failed
}

enum SourceType {
  WEB
  PDF
}

enum SocialProfileType {
  INSTAGRAM_ONLY
  LINKEDIN_ONLY
  BOTH
  NONE
}

enum AudioGender {
  MALE
  FEMALE
}
// ── System zaproszeń (invite-only) ───────────────────────────────────────────

enum InviteCodeStatus {
  issued    // wystawiony, jeszcze nieużyty i nieprzeterminowany
  used      // zużyty przy rejestracji (usedByUserId wypełnione)
  expired   // po 24h lub ręcznie wygaszony (ustawiane leniwie/cronem)
}

enum ApplicationStatus {
  pending   // świeży wniosek z modala "Apply", czeka na decyzję
  invited   // zaakceptowany, wystawiono kod (inviteCode wypełnione)
  rejected  // odrzucony
}

// Wniosek z publicznego modala "Apply" (inbound). Po akceptacji wiążemy z kodem.
model Application {
  id         String            @id @default(cuid())
  firstName  String
  email      String
  website    String?
  instagram  String?
  facebook   String?
  youtube    String?
  linkedin   String?
  status     ApplicationStatus @default(pending)
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  inviteCode InviteCode?       // wystawiony po akceptacji (1:1)

  @@index([status])
  @@index([email])
  @@map("applications")
}

// Kod zaproszenia. Powstaje dwiema drogami:
//   - inbound: z zaakceptowanego Application (applicationId wypełnione),
//   - outbound: ręcznie pod leada z prospectora (recipientHandle + recipientNote).
// Ważność = status == issued AND expiresAt > now(). Status 'expired' ustawiamy
// leniwie/cronem — żywa walidacja zawsze sprawdza expiresAt niezależnie od statusu.
model InviteCode {
  id              String           @id @default(cuid())
  code            String           @unique // krótki, URL-safe token do magic linku /r/{code}
  status          InviteCodeStatus @default(issued)

  recipientHandle String?          // np. "@xyz" — komu wysłaliśmy (gdy bez Application)
  recipientNote   String?          // wewnętrzna notatka: kto to / z jakiego segmentu

  expiresAt       DateTime         // = createdAt + 24h (liczone app-side przy tworzeniu)
  clickedAt       DateTime?        // pierwszy raz, gdy ktoś otworzył link rejestracji z tym kodem (lejek: Clicked)
  usedAt          DateTime?
  usedByUserId    String?          @unique // user, który zużył kod (1:1)

  applicationId   String?          @unique // źródłowy wniosek (gdy inbound)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  seeds           InviteCodeSeed[]
  usedBy          User?            @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
  application     Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@map("invite_codes")
}

// 3 propozycje tytuł + podtytuł przypięte do kodu (snapshot tego, co
// zaproponowaliśmy). Przy rejestracji materializujemy je w `ebooks` jako drafty
// usera — te wiersze zostają jako oryginał/audyt i nie są edytowane.
model InviteCodeSeed {
  id           String     @id @default(cuid())
  inviteCodeId String
  position     Int        // 1..3 — kolejność prezentacji
  title        String     @db.VarChar(255)
  subtitle     String
  description  String?    @db.Text  // opis/wytyczne dla tego tytułu (opcjonalne, też generowane)
  createdAt    DateTime   @default(now())
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, position])
  @@index([inviteCodeId])
  @@map("invite_code_seeds")
}

// Singleton ustawień aplikacji — JEDEN wiersz o stałym id "app".
// Panel GOD edytuje, rejestracja czyta. Trwałe między restartami (w przeciwieństwie
// do stanu w pamięci) i zmienialne bez redeployu (w przeciwieństwie do .env).
model AppSetting {
  id         String   @id @default("app") // zawsze "app" — wymuszamy jeden rekord
  inviteOnly Boolean  @default(true)      // true = bez ważnego kodu nie ma rejestracji
  updatedAt  DateTime @updatedAt

  @@map("app_settings")
}